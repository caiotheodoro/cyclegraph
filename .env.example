# cyclegraph environment. Copy to .env; .env is gitignored.
#
# The raw Egocentric-10K corpus is gated. A token with accepted terms is required
# for every corpus read. docs/REPRODUCTION.md states what runs without one.
HF_TOKEN=

# Optional. Only set if re-judging frames rather than reusing committed labels.
# docs/METHOD.md states which stages need it and what they cost.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# GPU stages (E3 hand detector, optical flow) run on AWS through the CLI, not locally.
# docs/REPRODUCTION.md "Compute" states the instance class and the stage-by-stage plan.
AWS_PROFILE=
AWS_REGION=
